{
  "permissions": {
    "allow": [
      "Bash(npx jest)",
      "Bash(npx jest *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc *)",
      "Bash(npx eslint . --ext .ts,.tsx)",
      "Bash(npx eslint *)",
      "Bash(npx prettier --check \"src/**/*.{ts,tsx}\")",
      "Bash(npx prettier --check *)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:mutation)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-gate.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-usage.mjs\""
          }
        ]
      }
    ]
  }
}
